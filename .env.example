# Copy to .env and fill locally. Never commit real credentials.
# SQLcl saved passwords are NOT extracted or reused by the Python service.
FASTONTO_DB_USER=FASTONTO
FASTONTO_DB_PASSWORD=
FASTONTO_DB_DSN=
FASTONTO_DB_POOL_MAX=4
FASTONTO_DB_TIMEOUT_MS=10000

# Base64url-encoded 32-byte AES-256-GCM key for encrypted external Oracle
# source credentials stored in FASTONTO. Generate and store locally only.
FASTONTO_SOURCE_MASTER_KEY=
FASTONTO_SOURCE_MASTER_KEY_VERSION=v1

# Exact browser origin. Remote HTTP is a temporary, explicit risk acceptance.
FASTONTO_PUBLIC_ORIGIN=http://127.0.0.1:8025
FASTONTO_ALLOW_INSECURE_HTTP=false
FASTONTO_SESSION_HOURS=8
FASTONTO_SESSION_IDLE_MINUTES=30
# For direct HTTPS on port 8025, configure both absolute paths.
FASTONTO_TLS_CERT_FILE=
FASTONTO_TLS_KEY_FILE=
